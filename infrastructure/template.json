{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Lambda sencilla creada con CloudFormation para aprender Infrastructure as Code.\n",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "Default": "dev",
      "AllowedValues": [
        "dev",
        "prod"
      ],
      "Description": "Ambiente donde se desplegara la aplicacion."
    }
  },
  "Resources": {
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowLambdaToAssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "SendMessagesToSupportJobsQueue",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AllowSendingSupportJobs",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": "SupportJobsQueue.Arn"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "EnvironmentName"
          },
          {
            "Key": "Project",
            "Value": "hello-lambda"
          }
        ]
      }
    },
    "ApiLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "ApiLambdaLogGroup"
      ],
      "Properties": {
        "FunctionName": "ai-customer-support-agent-${EnvironmentName}",
        "Description": "Lambda creada completamente mediante CloudFormation.",
        "Runtime": "python3.14",
        "Handler": "functions.api.handler.handler",
        "Role": "LambdaExecutionRole.Arn",
        "Code": "../src/",
        "MemorySize": 128,
        "Timeout": 10,
        "Environment": {
          "Variables": {
            "APP_ENV": "EnvironmentName",
            "SERVICE_NAME": "ai-customer-support-agent",
            "LOG_LEVEL": "INFO",
            "SUPPORT_JOBS_QUEUE_URL": "SupportJobsQueue",
            "BEDROCK_MODEL_ID": "amazon.nova-micro-v1:0",
            "KNOWLEDGE_BASE_ID": "SupportKnowledgeBase",
            "AGENTCORE_RUNTIME_ARN": "SupportAgentRuntime.AgentRuntimeArn",
            "AGENTCORE_MEMORY_ID": "SupportAgentMemory.MemoryId"
          }
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "EnvironmentName"
          },
          {
            "Key": "Project",
            "Value": "hello-lambda"
          }
        ]
      }
    },
    "ApiLambdaLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/ai-customer-support-agent-${EnvironmentName}",
        "RetentionInDays": 14
      }
    },
    "SupportHttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "ai-customer-support-agent-api-${EnvironmentName}",
        "Description": "HTTP API for the AI Customer Support Agent",
        "ProtocolType": "HTTP"
      }
    },
    "ApiLambdaIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": "SupportHttpApi",
        "Description": "Lambda proxy integration for the support API",
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": [
          "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${FunctionArn}/invocations",
          {
            "FunctionArn": "ApiLambdaFunction.Arn"
          }
        ],
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 10000
      }
    },
    "HealthRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": "SupportHttpApi",
        "AuthorizationType": "NONE",
        "RouteKey": "GET /health",
        "Target": "integrations/${ApiLambdaIntegration}"
      }
    },
    "ChatRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": "SupportHttpApi",
        "AuthorizationType": "NONE",
        "RouteKey": "POST /chat",
        "Target": "integrations/${ApiLambdaIntegration}"
      }
    },
    "DefaultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": "SupportHttpApi",
        "AuthorizationType": "NONE",
        "RouteKey": "$default",
        "Target": "integrations/${ApiLambdaIntegration}"
      }
    },
    "ApiGatewayAccessLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/apigateway/ai-customer-support-agent-${EnvironmentName}",
        "RetentionInDays": 14
      }
    },
    "ApiDefaultStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "DependsOn": [
        "ApiGatewayAccessLogGroup"
      ],
      "Properties": {
        "ApiId": "SupportHttpApi",
        "StageName": "$default",
        "AutoDeploy": true,
        "AccessLogSettings": {
          "DestinationArn": "ApiGatewayAccessLogGroup.Arn",
          "Format": "{\"request_id\":\"$context.requestId\",\"method\":\"$context.httpMethod\",\"route_key\":\"$context.routeKey\",\"path\":\"$context.path\",\"status\":\"$context.status\",\"response_length\":\"$context.responseLength\",\"response_latency\":\"$context.responseLatency\",\"source_ip\":\"$context.identity.sourceIp\"}"
        }
      }
    },
    "ApiGatewayInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": "ApiLambdaFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": [
          "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ApiId}/*",
          {
            "ApiId": "SupportHttpApi"
          }
        ]
      }
    },
    "SupportJobsDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "ai-customer-support-jobs-dlq-${EnvironmentName}"
      }
    },
    "SupportJobsQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "ai-customer-support-jobs-${EnvironmentName}",
        "VisibilityTimeout": 60,
        "RedrivePolicy": {
          "deadLetterTargetArn": "SupportJobsDeadLetterQueue.Arn",
          "maxReceiveCount": 5
        }
      }
    },
    "WorkerLambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowLambdaToAssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "ConsumeSupportJobsQueue",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AllowConsumingSupportJobs",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": "SupportJobsQueue.Arn"
                }
              ]
            }
          },
          {
            "PolicyName": "CommunicationWithBedrock",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AllowInvokeSupportAgentRuntime",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:InvokeAgentRuntime"
                  ],
                  "Resource": [
                    "SupportAgentRuntime.AgentRuntimeArn",
                    [
                      "${RuntimeArn}/runtime-endpoint/DEFAULT",
                      {
                        "RuntimeArn": "SupportAgentRuntime.AgentRuntimeArn"
                      }
                    ]
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "EnvironmentName"
          },
          {
            "Key": "Project",
            "Value": "ai-customer-support-agent"
          }
        ]
      }
    },
    "SupportJobsWorkerLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "WorkerLambdaLogGroup"
      ],
      "Properties": {
        "FunctionName": "ai-customer-support-worker-${EnvironmentName}",
        "Description": "Processes support jobs pulled from SQS.",
        "Runtime": "python3.14",
        "Handler": "functions.worker.handler.handler",
        "Role": "WorkerLambdaExecutionRole.Arn",
        "Code": "../src/",
        "MemorySize": 128,
        "Timeout": 30,
        "Environment": {
          "Variables": {
            "APP_ENV": "EnvironmentName",
            "SERVICE_NAME": "ai-customer-support-worker",
            "LOG_LEVEL": "INFO",
            "SUPPORT_JOBS_QUEUE_URL": "SupportJobsQueue",
            "BEDROCK_MODEL_ID": "amazon.nova-micro-v1:0",
            "KNOWLEDGE_BASE_ID": "SupportKnowledgeBase",
            "AGENTCORE_RUNTIME_ARN": "SupportAgentRuntime.AgentRuntimeArn",
            "AGENTCORE_MEMORY_ID": "SupportAgentMemory.MemoryId"
          }
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "EnvironmentName"
          },
          {
            "Key": "Project",
            "Value": "ai-customer-support-agent"
          }
        ]
      }
    },
    "WorkerLambdaLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/ai-customer-support-worker-${EnvironmentName}",
        "RetentionInDays": 14
      }
    },
    "SupportJobsEventSourceMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": "SupportJobsQueue.Arn",
        "FunctionName": "SupportJobsWorkerLambdaFunction",
        "Enabled": true,
        "BatchSize": 5,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ]
      }
    },
    "KnowledgeBaseSourceBucket": {
      "Type": "AWS::S3::Bucket"
    },
    "KnowledgeBaseVectorBucket": {
      "Type": "AWS::S3Vectors::VectorBucket",
      "Properties": {
        "VectorBucketName": "squad-prep-ai-customer-support-knowledge-base-vectors-${EnvironmentName}"
      }
    },
    "KnowledgeBaseVectorIndex": {
      "Type": "AWS::S3Vectors::Index",
      "Properties": {
        "VectorBucketArn": "KnowledgeBaseVectorBucket",
        "IndexName": "knowledge-base-index",
        "DataType": "float32",
        "Dimension": 1024,
        "DistanceMetric": "cosine"
      }
    },
    "KnowledgeBaseServiceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "bedrock.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "IngestDocsForRAG",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AllowListSourceBucket",
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": "KnowledgeBaseSourceBucket.Arn"
                },
                {
                  "Sid": "AllowReadFromSourceBucket",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": "${KnowledgeBaseSourceBucket.Arn}/*"
                },
                {
                  "Sid": "AllowInvokeEmbeddingModel",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": "arn:${AWS::Partition}:bedrock:${AWS::Region}::foundation-model/amazon.titan-embed-text-v2:0"
                },
                {
                  "Sid": "AllowAccessToVectorIndex",
                  "Effect": "Allow",
                  "Action": [
                    "s3vectors:PutVectors",
                    "s3vectors:GetVectors",
                    "s3vectors:DeleteVectors",
                    "s3vectors:QueryVectors",
                    "s3vectors:GetIndex"
                  ],
                  "Resource": "KnowledgeBaseVectorIndex.IndexArn"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "EnvironmentName"
          },
          {
            "Key": "Project",
            "Value": "ai-customer-support-agent"
          }
        ]
      }
    },
    "SupportKnowledgeBase": {
      "Type": "AWS::Bedrock::KnowledgeBase",
      "Properties": {
        "Name": "ai-customer-support-knowledge-base-${EnvironmentName}",
        "RoleArn": "KnowledgeBaseServiceRole.Arn",
        "KnowledgeBaseConfiguration": {
          "Type": "VECTOR",
          "VectorKnowledgeBaseConfiguration": {
            "EmbeddingModelArn": "arn:${AWS::Partition}:bedrock:${AWS::Region}::foundation-model/amazon.titan-embed-text-v2:0"
          }
        },
        "StorageConfiguration": {
          "Type": "S3_VECTORS",
          "S3VectorsConfiguration": {
            "IndexArn": "KnowledgeBaseVectorIndex.IndexArn"
          }
        }
      }
    },
    "SupportKnowledgeBaseDataSource": {
      "Type": "AWS::Bedrock::DataSource",
      "Properties": {
        "Name": "ai-customer-support-knowledge-base-data-source-${EnvironmentName}",
        "KnowledgeBaseId": "SupportKnowledgeBase",
        "DataDeletionPolicy": "DELETE",
        "DataSourceConfiguration": {
          "Type": "S3",
          "S3Configuration": {
            "BucketArn": "KnowledgeBaseSourceBucket.Arn"
          }
        }
      }
    },
    "AgentCoreExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowAgentCoreToAssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "bedrock-agentcore.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ],
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "AWS::AccountId"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:*"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "AgentRuntimePermissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AllowBedrockInference",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": "arn:${AWS::Partition}:bedrock:${AWS::Region}::foundation-model/amazon.nova-micro-v1:0"
                },
                {
                  "Sid": "AllowKnowledgeBaseRetrieval",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:Retrieve"
                  ],
                  "Resource": "SupportKnowledgeBase.KnowledgeBaseArn"
                },
                {
                  "Sid": "AllowReadAgentRuntimeArtifact",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": "${AgentCoreCodeBucket.Arn}/*"
                },
                {
                  "Sid": "AllowAgentCoreCreateLogGroups",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:DescribeLogStreams"
                  ],
                  "Resource": [
                    "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/*"
                  ]
                },
                {
                  "Sid": "AllowAgentCoreDescribeLogGroups",
                  "Effect": "Allow",
                  "Action": [
                    "logs:DescribeLogGroups"
                  ],
                  "Resource": [
                    "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:*"
                  ]
                },
                {
                  "Sid": "AllowAgentCoreWriteLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/*:log-stream:*"
                  ]
                },
                {
                  "Sid": "AllowAgentCoreXRay",
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords",
                    "xray:GetSamplingRules",
                    "xray:GetSamplingTargets"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "AllowAgentCoreMetrics",
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:PutMetricData"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "cloudwatch:namespace": "bedrock-agentcore"
                    }
                  }
                },
                {
                  "Sid": "AllowAgentCoreShortTermMemory",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateEvent",
                    "bedrock-agentcore:ListEvents"
                  ],
                  "Resource": [
                    "SupportAgentMemory.MemoryArn"
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "EnvironmentName"
          },
          {
            "Key": "Project",
            "Value": "ai-customer-support-agent"
          }
        ]
      }
    },
    "AgentCoreCodeBucket": {
      "Type": "AWS::S3::Bucket"
    },
    "SupportAgentRuntime": {
      "Type": "AWS::BedrockAgentCore::Runtime",
      "Properties": {
        "AgentRuntimeName": "ai_customer_support_agent_${EnvironmentName}",
        "Description": "Runtime for the AI Customer Support Agent",
        "RoleArn": "AgentCoreExecutionRole.Arn",
        "AgentRuntimeArtifact": {
          "CodeConfiguration": {
            "Code": {
              "S3": {
                "Bucket": "AgentCoreCodeBucket",
                "Prefix": "agentcore-runtime-v12.zip"
              }
            },
            "Runtime": "PYTHON_3_14",
            "EntryPoint": [
              "agentcore_app.py"
            ]
          }
        },
        "NetworkConfiguration": {
          "NetworkMode": "PUBLIC"
        },
        "EnvironmentVariables": {
          "APP_ENV": "EnvironmentName",
          "SERVICE_NAME": "ai-customer-support-agentcore",
          "LOG_LEVEL": "INFO",
          "SUPPORT_JOBS_QUEUE_URL": "SupportJobsQueue",
          "BEDROCK_MODEL_ID": "amazon.nova-micro-v1:0",
          "KNOWLEDGE_BASE_ID": "SupportKnowledgeBase",
          "AGENTCORE_MEMORY_ID": "SupportAgentMemory.MemoryId"
        },
        "Tags": {
          "Environment": "EnvironmentName",
          "Project": "ai-customer-support-agent"
        }
      }
    },
    "SupportAgentMemory": {
      "Type": "AWS::BedrockAgentCore::Memory",
      "Properties": {
        "Name": "ai_customer_support_memory_${EnvironmentName}",
        "Description": "Short-term conversational memory for the customer support agent",
        "EventExpiryDuration": 30,
        "Tags": {
          "Environment": "EnvironmentName",
          "Project": "ai-customer-support-agent"
        }
      }
    },
    "AgentCoreGatewayExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "bedrock-agentcore.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeGatewayToolsLambda",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": "GatewayToolsLambdaFunction.Arn"
                }
              ]
            }
          }
        ]
      }
    },
    "SupportToolsGateway": {
      "Type": "AWS::BedrockAgentCore::Gateway",
      "Properties": {
        "Name": "ai-customer-support-gateway-${EnvironmentName}",
        "Description": "Gateway for customer support agent tools",
        "RoleArn": "AgentCoreGatewayExecutionRole.Arn",
        "ProtocolType": "MCP",
        "AuthorizerType": "NONE"
      }
    },
    "GatewayToolsLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "ai-customer-support-gateway-tools-${EnvironmentName}",
        "Runtime": "python3.14",
        "Handler": "functions.gateway_tools.handler.handler",
        "Role": "GatewayToolsLambdaExecutionRole.Arn",
        "Code": "../src/"
      }
    },
    "GatewayToolsLambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ]
      }
    },
    "SupportToolsGatewayTarget": {
      "Type": "AWS::BedrockAgentCore::GatewayTarget",
      "Properties": {
        "Name": "support-tools-${EnvironmentName}",
        "GatewayIdentifier": "SupportToolsGateway.GatewayIdentifier",
        "CredentialProviderConfigurations": [
          {
            "CredentialProviderType": "GATEWAY_IAM_ROLE"
          }
        ],
        "TargetConfiguration": {
          "Mcp": {
            "Lambda": {
              "LambdaArn": "GatewayToolsLambdaFunction.Arn",
              "ToolSchema": {
                "InlinePayload": [
                  {
                    "Name": "get_order",
                    "Description": "Get the current status of an order",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "order_id": {
                          "Type": "string"
                        }
                      },
                      "Required": [
                        "order_id"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "LambdaFunctionName": {
      "Description": "Nombre fisico de la funcion Lambda.",
      "Value": "ApiLambdaFunction"
    },
    "LambdaFunctionArn": {
      "Description": "ARN de la funcion Lambda.",
      "Value": "ApiLambdaFunction.Arn"
    },
    "LambdaExecutionRoleName": {
      "Description": "Nombre del execution role.",
      "Value": "LambdaExecutionRole"
    },
    "LambdaExecutionRoleArn": {
      "Description": "ARN del execution role.",
      "Value": "LambdaExecutionRole.Arn"
    },
    "ApiId": {
      "Description": "ID of the API Gateway HTTP API",
      "Value": "SupportHttpApi"
    },
    "ApiUrl": {
      "Description": "Base URL of the API",
      "Value": "https://${SupportHttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}"
    },
    "HealthUrl": {
      "Description": "Health endpoint URL",
      "Value": "https://${SupportHttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/health"
    },
    "ChatUrl": {
      "Description": "Chat endpoint URL",
      "Value": "https://${SupportHttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/chat"
    },
    "SupportJobsQueueUrl": {
      "Description": "Main Queue URL",
      "Value": "SupportJobsQueue"
    },
    "SupportJobsQueueArn": {
      "Description": "Main Queue ARN",
      "Value": "SupportJobsQueue.Arn"
    },
    "SupportJobsWorkerFunctionName": {
      "Description": "Worker Lambda function name",
      "Value": "SupportJobsWorkerLambdaFunction"
    },
    "SupportJobsWorkerFunctionArn": {
      "Description": "Worker Lambda function ARN",
      "Value": "SupportJobsWorkerLambdaFunction.Arn"
    },
    "SupportJobsWorkerExecutionRoleName": {
      "Description": "Worker Lambda execution role name",
      "Value": "WorkerLambdaExecutionRole"
    },
    "SupportJobsWorkerExecutionRoleArn": {
      "Description": "Worker Lambda execution role ARN",
      "Value": "WorkerLambdaExecutionRole.Arn"
    },
    "SupportJobsDeadLetterQueueUrl": {
      "Description": "Dead queue URL",
      "Value": "SupportJobsDeadLetterQueue"
    },
    "SupportJobsDeadLetterQueueArn": {
      "Description": "Dead queue ARN",
